# ---------------------------------------------------------------------------
# Ricky - voice alert app
# Copy this file to `.env` and fill in what you have.
# Everything except the Google keys is optional; without phone credentials the
# app runs in "simulate" mode so you can still hear every generated voice note.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=4173
HOST=127.0.0.1
# Must be a public https URL for Twilio to fetch the call audio (use ngrok).
# Leave blank to default to http://127.0.0.1:4173
PUBLIC_BASE_URL=

# --- Google / Gmail (required to monitor your inbox) ------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add this exact URL to "Authorized redirect URIs" in Google Cloud:
# http://127.0.0.1:4173/oauth2callback
GOOGLE_REDIRECT_URI=

# --- ElevenLabs (voice generation) -----------------------------------------
ELEVENLABS_API_KEY=
# Voice used for the spoken alert. Browse voices in the ElevenLabs dashboard.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: native ElevenLabs phone calls (ElevenLabs Agents + Twilio import).
# Set these two to let the ElevenLabs agent place the call itself.
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# --- Twilio (only if you want Ricky to dial using the generated MP3) --------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Behaviour --------------------------------------------------------------
POLL_SECONDS=60
