# ---------------------------------------------------------------------------
# Ricky — private voice alerts for important email
#
# Copy to .env and fill in what you have. Only the Google keys are required to
# watch an inbox. Voice works out of the box thanks to the free Edge fallback,
# and push calls work as soon as you enable them on your phone.
#
# Nothing here costs money on the free tiers:
#   Google OAuth .......... free
#   ElevenLabs ............ free tier (optional — Edge voices are free)
#   Web Push (VAPID) ...... free, no account
#   Upstash Redis ......... free tier (only needed on Vercel)
#   Render / Vercel ....... free tier
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=4173
HOST=127.0.0.1

# The public https address of this deployment. Required for push on a phone.
# Locally you can leave it blank and use an ngrok tunnel when testing:
#   ngrok http 4173   ->   PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=

# --- Access control ---------------------------------------------------------
# Strongly recommended before exposing the app to the internet: without it
# anyone with the URL can read your inbox summary and ring your phone.
APP_PASSWORD=
# Optional. Defaults to APP_PASSWORD. Change only if you rotate the password.
SESSION_SECRET=

# --- Google / Gmail (required to monitor your inbox) ------------------------
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be exactly:
#   <PUBLIC_BASE_URL>/oauth2callback    (or http://127.0.0.1:4173/oauth2callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave blank to derive it from PUBLIC_BASE_URL or the request host.
GOOGLE_REDIRECT_URI=

# --- Sign-in page video (optional) ------------------------------------------
# The split sign-in page shows a looping video on the left. By default it
# uses public/media/login.mp4 (with login-poster.jpg as the first frame).
# Set this to any hosted MP4/WebM to use your own clip instead.
LOGIN_VIDEO_URL=

# --- Voice generation -------------------------------------------------------
# auto       = ElevenLabs when a key is present, otherwise free Edge voices
# elevenlabs = ElevenLabs only (falls back to Edge on error anyway)
# edge       = always use free Microsoft Edge neural voices
TTS_PROVIDER=auto

# ElevenLabs free tier. Optional.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Free fallback voice (no key, no account). Any Edge neural voice works.
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=+0%

# --- Web Push (the incoming call) -------------------------------------------
# Generate a pair with:  npm run vapid
# If these are blank the server generates and stores a pair on first boot,
# which is fine locally but loses subscriptions when the disk is reset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Durable storage (required on Vercel) -----------------------------------
# Create a free Redis database at https://upstash.com and copy the REST URL and
# token. Vercel KV exposes the same two variables (KV_REST_API_URL/TOKEN), which
# are also picked up automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scheduling -------------------------------------------------------------
# Long-running hosts (local, Render, Docker) poll in-process by default.
# Serverless must be pinged by a free external cron instead.
SELF_POLL=
POLL_SECONDS=60

# Secret for /api/cron/scan?key=... . Required to enable scheduled scans when
# SELF_POLL is off. GitHub Actions and cron-job.org can both call it for free.
CRON_SECRET=
